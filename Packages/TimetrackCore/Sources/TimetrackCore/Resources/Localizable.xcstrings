      }
    },
    "error.database_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank des Servers ist gerade nicht erreichbar. Bitte versuche es in ein paar Sekunden erneut."
          }
        }
      }
    },
    "error.decoding": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Servers wurde nicht verstanden."
          }
        }
      }
