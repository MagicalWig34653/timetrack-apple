{
  "sourceLanguage": "de",
  "version": "1.0",
  "strings": {
    "error.absence_overlap": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Zeitraum gibt es bereits eine andere Abwesenheit. Abwesenheiten dürfen sich nicht überschneiden."
          }
        }
      }
    },
    "error.bad_request": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingabe ist ungültig."
          }
        }
      }
    },
    "error.cancelled": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen."
          }
        }
      }
    },
    "error.cannot_share_with_self": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nichts an dein eigenes Konto freigeben."
          }
        }
      }
    },
    "error.conflict": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion steht im Konflikt mit dem aktuellen Stand."
          }
