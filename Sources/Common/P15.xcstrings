    },
    "adj.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server liefert keine Liste der Anpassungen (ab Vertrag 0.29.0). Es werden nur die Summen oben angezeigt."
          }
        }
      }
    },
    "legal.day_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informative Hinweise, keine Rechtsberatung. Erfasste Zeiten bleiben unverändert."
          }
        }
      }
    },
    "legal.explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil gilt ab dem Beginn dieser Version und steuert nur die Hinweise zu Pausen, Höchstzeiten und Berufsschule. Erfasste Zeiten werden nie abgewiesen. Erwachsene in Ausbildung wählen das Erwachsenenprofil. Für einen Wechsel, zum Beispiel mit 18, legst du eine neue Version ab dem Stichtag an; frühere Tage behalten ihr Profil. Eine automatische Umstellung am Geburtstag gibt es nicht."
          }
        }
      }
    },
    "legal.lessons": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterrichtsstunden (mind. 45 Min.)"
          }
        }
      }
    },
    "legal.lessons.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angegeben"
          }
        }
      }
    },
    "legal.minor_school": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Jugendliche trägst du an Berufsschultagen die Zahl der Unterrichtsstunden (mindestens 45 Minuten) in der Tagesansicht von „Zeit“ ein; sie lässt sich nicht aus der Dauer berechnen. Ab sechs Stunden gilt einmal pro Woche eine Gutschrift von 8 Stunden, bei Blockunterricht mit mindestens 25 Stunden an fünf Tagen 40 Stunden. Das ist eine Produktannahme und fachlich noch nicht geprüft."
          }
        }
      }
    },
    "legal.no_details": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln und Quellen konnte die App nicht vom Server laden (ältere Version). Die Auswahl funktioniert trotzdem."
          }
        }
      }
    },
    "legal.notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informative Hinweise, keine Rechtsberatung. Eine leere Hinweisliste bedeutet nicht, dass alles rechtskonform ist."
          }
        }
      }
    },
    "legal.sources": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellen"
          }
        }
      }
    },
    "legal.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsprofil"
          }
        }
      }
    },
    "legal.unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil kennt die App nicht. Der Server prüft die Angabe beim Speichern."
          }
        }
      }
    },
