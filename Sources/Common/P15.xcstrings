    "review.section.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag ist zur Prüfung markiert. Wenn die Zeiten stimmen, kannst du die Markierung quittieren; eine Korrektur des Endes entfernt sie ebenfalls."
          }
