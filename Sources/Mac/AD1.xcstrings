    "set_b.export.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere deine Arbeitszeiten für einen Zeitraum als Tabelle oder PDF, zum Beispiel als Nachweis. Der Export läuft in der Web-App und öffnet im Browser."
          }
        }
      }
    },
    "set_b.export.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Web-App im Browser"
          }
        }
      }
    },
    "set_b.export.open": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export in der Web-App öffnen"
          }
        }
      }
    },
    "set_b.focus.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort startet und stoppt ein iOS-Fokus (zum Beispiel „Arbeit“) den Timer automatisch oder fragt vorher nach. Die Einrichtung geschieht in den iOS-Einstellungen unter Fokus und in der Timetrack-App auf dem iPhone. Auf dem Mac gibt es keinen Fokus-Filter."
          }
        }
      }
    },
    "set_b.focus.mac_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mac-Automatik übernimmt Ähnliches: Unter „Orte“ legst du fest, wann ein Timer beim Ankommen oder Verlassen eines Orts gestartet oder gestoppt wird, und unter „Menüleiste“ steuerst du den Timer ohne Fenster."
          }
        }
      }
    },
    "set_b.focus.mac_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Mac"
          }
        }
      }
    },
    "set_b.focus.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Filter gibt es auf iPhone und iPad"
          }
        }
      }
    },
