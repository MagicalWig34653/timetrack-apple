    "wm.account.confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeitkonto ändert sich sofort. Eine gebuchte Korrektur kann nicht gelöscht werden; du gleichst sie mit einer Gegenbuchung aus."
          }
        }
      }
    },
    "wm.account.correction_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine datierte Gutschrift oder ein Abzug auf dem Zeitkonto, zum Beispiel für einen Zeitausgleich. Eine Korrektur lässt sich nicht löschen, nur mit einer Gegenbuchung ausgleichen."
          }
        }
      }
    },
    "wm.account.correction_save": {
