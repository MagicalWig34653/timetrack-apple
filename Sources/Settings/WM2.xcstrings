    "wm.account.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand deines Zeitkontos mit Anfangsstand und Korrekturen. Der Saldo ergibt sich aus den ausgewerteten Tagen; hier buchst du Anfangsstand oder eine datierte Korrektur mit Begründung."
          }
        }
      }
    },
    "wm.account.invalid_reason": {
      "extractionState": "manual",
