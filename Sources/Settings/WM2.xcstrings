      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version gilt ab dem gewählten Tag. Die laufende Version endet am Vortag, alles davor bleibt unverändert. Die Werte sind mit der neuesten Version vorbelegt."
          }
        }
      }
    },
