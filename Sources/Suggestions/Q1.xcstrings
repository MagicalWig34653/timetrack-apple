    },
    "q1.review.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Automatik markiert einen Eintrag, wenn sie ihn gestartet hat und das Ende nie gemeldet wurde. Mit „Passt so“ oder einer Korrektur verschwindet er aus dieser Liste (auf diesem Gerät)."
          }
        }
      }
    },
    "q1.review.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Liste mit Grund und Möglichkeiten zur Korrektur"
          }
        }
      }
    },
    "q1.review.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einträge brauchen einen Blick von dir. Timetrack ändert nichts von selbst."
