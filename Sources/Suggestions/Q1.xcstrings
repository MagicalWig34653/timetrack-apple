    "q1.editor.reason": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Prüfung angepasst"
          }
        }
      }
    },
    "q1.reason.end_missing.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Automatik hat diesen Eintrag gestartet, aber nie ein Ende erhalten. Er läuft noch oder wurde vergessen."
          }
        }
      }
    },
    "q1.reason.end_missing.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende fehlt"
          }
        }
      }
    },
    "q1.reason.marked.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag wurde von der Automatik angelegt und ist als „bitte prüfen“ markiert, obwohl er inzwischen ein Ende hat."
          }
        }
      }
    },
    "q1.reason.marked.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Automatik markiert"
          }
        }
      }
    },
    "q1.reason.proposed.detail %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Automatik hat diesen Eintrag gestartet, aber kein Ende erhalten. Sie schlägt %@ Uhr als Ende vor."
          }
        }
      }
    },
    "q1.reason.proposed.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende fehlt – Vorschlag der Automatik"
          }
        }
      }
    },
    "q1.review.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu prüfen"
          }
