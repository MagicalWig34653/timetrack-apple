    "focus.intro.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltest du in iOS einen Fokus ein (zum Beispiel „Arbeit“), kann Timetrack den Timer für dich starten oder vorher nachfragen. Endet der Fokus, stoppt Timetrack den Timer wieder."
          }
        }
      }
    },
    "focus.intro.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer mit deinem Fokus verbinden"
          }
        }
      }
    },
