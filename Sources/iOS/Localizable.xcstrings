      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert werden nur Modus, Art und Ort des Filters auf diesem Gerät, keine Zugangsdaten."
          }
        }
      }
    },
    "focus.rules.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus (empfohlen): Timetrack stoppt nur Timer, die der Fokus selbst gestartet hat. Ein Timer anderer Art, zum Beispiel Fahrt, wird nie gestoppt. Pausen oder Lücken erfindet Timetrack nicht."
          }
        }
      }
    },
    "focus.rules.manual": {
      "extractionState": "manual",
      "localizations": {
