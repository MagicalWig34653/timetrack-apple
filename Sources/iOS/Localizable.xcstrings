    "appearance.glow.desc.medium": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größerer Schein, farbige Kartenkanten und ein kräftigerer Farbhauch im Hintergrund."
          }
        }
      }
    },
    "appearance.glow.desc.off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Leuchteffekte, nur die Farben selbst."
          }
        }
      }
    },
    "appearance.glow.desc.strong": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Mittel, mit deutlichem Schein um Aktionen und Ringe und stärkerem Farbverlauf im Hintergrund."
          }
        }
      }
    },
    "appearance.glow.desc.subtle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauptaktionen, Ringe und der Hintergrund haben einen kaum sichtbaren Schein."
          }
        }
      }
    },
    "appearance.glow.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt Akzent- und Statusfarben leicht glühen. Wird im Konto gespeichert und gilt auf allen Geräten. Bei „Transparenz reduzieren“ und „Kontrast erhöhen“ entfällt der Schein."
          }
        }
      }
    },
    "appearance.glow.medium": {
      "extractionState": "manual",
