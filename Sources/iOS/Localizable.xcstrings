    },
    "focus.log.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt passiert"
          }
        }
      }
    },
    "focus.mode.direct.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timetrack startet den Timer beim Einschalten und stoppt ihn beim Ausschalten, ohne zu fragen. Läuft schon ein Timer, bleibt er unberührt. Beispiel: Fokus „Arbeit“ startet morgens die Arbeitszeit."
          }
        }
      }
    },
    "focus.mode.direct.short": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch"
          }
        }
      }
    },
    "focus.mode.direct.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch starten und stoppen"
          }
        }
      }
    },
    "focus.mode.off.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timetrack merkt sich nur, dass der Fokus an ist, und bucht nichts. Praktisch, um den Filter kurz stillzulegen."
          }
        }
      }
    },
    "focus.mode.off.short": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts tun"
          }
        }
      }
    },
    "focus.mode.off.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts tun"
          }
        }
      }
    },
    "focus.mode.suggest.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst eine Mitteilung „Timer starten?“ mit den Knöpfen Start und Nicht jetzt. Beim Ende des Fokus fragt Timetrack „Timer stoppen?“. Du entscheidest jedes Mal. Gut zum Ausprobieren."
          }
        }
      }
    },
    "focus.mode.suggest.short": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachfragen"
          }
        }
      }
    },
    "focus.mode.suggest.title": {
