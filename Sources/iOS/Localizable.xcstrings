    "focus.step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die iOS-Einstellungen und tippe auf „Fokus“. Wähle deinen Fokus, zum Beispiel „Arbeit“."
          }
        }
      }
    },
    "focus.step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unter „Fokusfilter“ auf „Filter hinzufügen“ und wähle „Timetrack“."
          }
        }
      }
    },
    "focus.step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was Timetrack tun soll (Nachfragen, Automatisch oder Nichts tun) und die Art (Arbeit, Fahrt oder Schule). Tippe auf „Hinzufügen“."
          }
        }
      }
    },
    "focus.steps.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl findest du nur in den iOS-Einstellungen, nicht in dieser App. Dort bestimmst du auch, bei welchem Fokus der Filter gilt."
          }
        }
      }
    },
    "focus.steps.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So richtest du es ein"
          }
        }
      }
    },
