          "stringUnit": {
            "state": "translated",
            "value": "So siehst du, ob iOS Timetrack überhaupt aufgerufen hat. „Keine Angaben“ heißt: iOS meldet das Ende eines Fokus (oder der Filter ist noch nicht eingerichtet)."
          }
        }
      }
    },
    "focus.delivery.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
