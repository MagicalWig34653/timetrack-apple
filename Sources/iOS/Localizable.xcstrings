            "value": "Nachfragen"
          }
        }
      }
    },
    "focus.modes.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Erlaube Timetrack in deinem Fokus unter „Erlaubte Apps“. Sonst hält iOS die Rückfrage zurück, bis der Fokus vorbei ist."
          }
        }
      }
    },
    "focus.modes.title": {
