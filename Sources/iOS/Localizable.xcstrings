    },
    "focus.log.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten zehn Aktionen des Filters, mit Uhrzeit, empfangenen Angaben und Ergebnis."
          }
        }
