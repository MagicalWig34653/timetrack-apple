          }
        }
      }
    },
    "focus.status.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timetrack erfährt vom Fokus nur, wenn er mit Filter ein- oder ausgeschaltet wird. Bis dahin steht hier „Kein Fokus-Filter aktiv“."
          }
        }
      }
    },
    "focus.status.none": {
      "extractionState": "manual",
